
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =================================================================
    // Helper Functions
    // =================================================================
    
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'belloimam431@gmail.com';
    }

    // This is more efficient than userExists() as it's used frequently
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isResourceOwner(resource) {
      // For get, update, delete: check if the existing document's businessId matches the user's.
      // This is safe because it runs on a single document, not a list.
      return request.auth != null && resource.data.businessId == getUserData().businessId;
    }
   
    function isCreatingForOwnBusiness() {
        // For create: check if the new document's businessId matches the user's.
        return request.auth != null && request.resource.data.businessId == getUserData().businessId;
    }

    function isAdmin() {
      return request.auth != null && getUserData().role == 'admin';
    }
   
    function isManager() {
      return request.auth != null && getUserData().role in ['admin', 'manager'];
    }

    // =================================================================
    // Public & Admin-Only Collections
    // =================================================================

    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /notifications/{notificationId} {
      allow list, get: if request.auth != null;
      allow create: if isSuperAdmin();
      allow update: if false;
      allow delete: if isSuperAdmin();
    }
   
    match /purchases/{purchaseId} {
      allow create: if request.auth != null;
      allow read, list: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /referrals/{referralId} {
        allow create: if request.auth != null;
        allow read, update, delete: if false;
    }

    // =================================================================
    // Multi-Tenant Collections
    // =================================================================

    match /businessInstances/{businessId} {
      allow get: if (request.auth != null && getUserData().businessId == businessId) || isSuperAdmin();
      allow list: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if (isAdmin() && getUserData().businessId == businessId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
     
      match /subscription_history/{historyId} {
        allow read, list: if (request.auth != null && getUserData().businessId == businessId) || isSuperAdmin();
        allow create: if request.auth != null || isSuperAdmin();
        allow update, delete: if false;
      }
    }

    match /users/{userId} {
      allow read, update: if (request.auth != null && request.auth.uid == userId) || (isAdmin() && isResourceOwner(resource)) || isSuperAdmin();
      allow list: if isAdmin() || isSuperAdmin();
      allow create: if request.auth != null;
      allow delete: if isAdmin() && isResourceOwner(resource) && request.auth.uid != userId;
      
      // User-specific notifications
      match /notifications/{notificationId} {
        allow read, list, delete: if request.auth != null && request.auth.uid == userId;
        // Only backend/trusted logic can create notifications
        allow create: if request.auth != null; 
        allow update: if request.auth != null && request.auth.uid == userId; // For marking as read
      }
    }
   
    match /invitations/{invitationId} {
      allow create: if isAdmin() && request.resource.data.businessId == getUserData().businessId;
      allow list: if isAdmin() || isSuperAdmin();
      allow read, delete: if request.auth != null && (resource.data.email == request.auth.token.email || (isAdmin() && isResourceOwner(resource)));
    }

    // --- Collections Secured by businessId ---
   
    match /products/{productId} {
      allow list: if isSuperAdmin() || (request.auth != null && 'businessId' in getUserData());
      allow get: if isResourceOwner(resource) || isSuperAdmin();
      allow create: if isManager() && isCreatingForOwnBusiness();
      allow update, delete: if isManager() && isResourceOwner(resource);
    }

    match /receipts/{receiptId} {
      allow list: if isSuperAdmin() || (request.auth != null && 'businessId' in getUserData());
      allow get: if isResourceOwner(resource) || isSuperAdmin();
      allow create: if isCreatingForOwnBusiness();
      allow update, delete: if isManager() && isResourceOwner(resource);
    }
    
    match /customers/{customerId} {
      allow list: if isSuperAdmin() || (request.auth != null && 'businessId' in getUserData());
      allow get: if isResourceOwner(resource) || isSuperAdmin();
      allow create: if isCreatingForOwnBusiness();
      allow update, delete: if isManager() && isResourceOwner(resource);
    }
  }
}
