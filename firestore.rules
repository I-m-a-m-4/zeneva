// Force rules update - Version 2.0.3
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =================================================================
    // Helper Functions
    // =================================================================
    
    function isSuperAdmin() {
      return request.auth != null && 
             (request.auth.uid == 'jzQgCHzaObeUbeYklTLtQQh03G53' || 
              (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email == 'belloimam431@gmail.com'));
    }

    match /{allPaths=**} {
      allow read, write: if isSuperAdmin();
    }

    function isUserAuthenticated() {
      return request.auth != null;
    }

    function getCurrentUserBusinessId() {
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return (request.auth != null && exists(userDocPath)) 
             ? get(userDocPath).data.get('businessId', 'none') 
             : 'none';
    }

    function getCurrentUserRole() {
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return (request.auth != null && exists(userDocPath)) 
             ? get(userDocPath).data.get('role', 'none') 
             : 'none';
    }

    function isRequestingUserMemberOf(businessId) {
      return isSuperAdmin() || (request.auth != null && getCurrentUserBusinessId() == businessId);
    }
    
    function isRequestingUserAdmin() {
      return request.auth != null && getCurrentUserRole() in ['admin', 'owner', 'super-admin'];
    }

    function isRequestingUserManager() {
      return request.auth != null && getCurrentUserRole() in ['admin', 'manager', 'owner', 'super-admin'];
    }

    function isRequestingUserStaff() {
      return request.auth != null && getCurrentUserRole() in ['admin', 'manager', 'vendor_operator', 'owner', 'super-admin'];
    }

    function isBusinessOwner(businessId) {
       return request.auth != null && 
              getCurrentUserBusinessId() == businessId && 
              getCurrentUserRole() in ['admin', 'owner'];
    }

    function isFieldUntouched(fieldName) {
      return !(fieldName in request.resource.data) || request.resource.data[fieldName] == resource.data[fieldName];
    }

    function isSubscriptionActive(businessId) {
      let business = get(/databases/$(database)/documents/businessInstances/$(businessId)).data;
      let trialExpiresAt = business.get('trialExpiresAt', null);
      let plan = business.get('plan', 'starter');
      let accessLevel = business.get('accessLevel', 'none');
      
      return isSuperAdmin() || 
             accessLevel == 'lifetime' || 
             (plan != 'starter') || 
             (trialExpiresAt != null && trialExpiresAt > request.time);
    }

    // =================================================================
    // Public & Admin-Only Collections
    // =================================================================

    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /notifications/{notificationId} {
      allow list, get: if isUserAuthenticated();
      allow create, delete: if isSuperAdmin();
      allow update: if false;
    }
   
    match /purchases/{purchaseId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read, list: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /supportThreads/{threadId} {
        allow read: if isSuperAdmin() || (isUserAuthenticated() && resource.data.userId == request.auth.uid);
        allow create: if isUserAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isSuperAdmin();

        match /messages/{messageId} {
            allow create: if isSuperAdmin() || (isUserAuthenticated() && get(/databases/$(database)/documents/supportThreads/$(threadId)).data.userId == request.auth.uid);
            allow read: if isSuperAdmin() || (isUserAuthenticated() && get(/databases/$(database)/documents/supportThreads/$(threadId)).data.userId == request.auth.uid);
        }
    }
    

    // =================================================================
    // Multi-Tenant Collections
    // =================================================================

    match /businessInstances/{businessId} {
      allow get: if isSuperAdmin() ||
                    (isUserAuthenticated() && isRequestingUserMemberOf(businessId)) ||
                    (isUserAuthenticated() && resource != null && resource.data.get('ownerId', null) == request.auth.uid) ||
                    (resource != null && resource.data.get(['settings', 'publicStore', 'enabled'], false) == true);
      
      allow list: if (isUserAuthenticated() && request.query.limit <= 1) || isSuperAdmin();
      
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update: if isSuperAdmin() || (isUserAuthenticated() && isRequestingUserAdmin() && isRequestingUserMemberOf(businessId) && 
                      isFieldUntouched('plan') && isFieldUntouched('trialExpiresAt')) || isBusinessOwner(businessId);
      allow delete: if isSuperAdmin();
      
      match /subscription_history/{historyId} {
        allow read, list: if isSuperAdmin() || (isUserAuthenticated() && isRequestingUserMemberOf(businessId));
        allow create: if isUserAuthenticated();
        allow update, delete: if false;
      }

      match /auditLogs/{logId} {
        allow list, get: if isSuperAdmin() || (isUserAuthenticated() && isRequestingUserAdmin() && isRequestingUserMemberOf(businessId));
        allow create: if isSuperAdmin() || (isUserAuthenticated() && isRequestingUserMemberOf(businessId));
        allow update, delete: if false;
      }

      match /onlineOrders/{orderId} {
         allow read, list: if isSuperAdmin() || (isUserAuthenticated() && isRequestingUserMemberOf(businessId));
         // Allow public to create orders, but restrict updates to staff
         allow create: if true; 
         allow update: if isSuperAdmin() || (isUserAuthenticated() && isRequestingUserMemberOf(businessId));
         allow delete: if false;
      }

      match /stats/{statId} {
        // Only allow pro/business plans to access historical stats
        allow read: if isSuperAdmin() || (isUserAuthenticated() && isRequestingUserMemberOf(businessId) && 
                      get(/databases/$(database)/documents/businessInstances/$(businessId)).data.get('plan', 'starter') in ['pro', 'business', 'starter']);
        allow write: if isSuperAdmin() || (isUserAuthenticated() && isRequestingUserMemberOf(businessId));
      }
    }

    match /users/{userId} {
      // Direct self-access or Super Admin access.
      allow get: if isSuperAdmin() || (request.auth != null && request.auth.uid == userId);
                    
      // Only SuperAdmin can list globally. Business Admins fetch their own staff.
      allow list: if isSuperAdmin() || 
                   (isUserAuthenticated() && 
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == resource.data.businessId);
      
      // Self-update or Super Admin
      allow update: if isSuperAdmin() || (request.auth != null && request.auth.uid == userId);

      // Self-create or Super Admin
      allow create: if isSuperAdmin() || (request.auth != null && request.auth.uid == userId);
      
      // Only Super admin can delete users to prevent rogue logic
      allow delete: if isSuperAdmin();
      
      match /notifications/{notificationId} {
        allow read, write: if isSuperAdmin() || (request.auth != null && request.auth.uid == userId);
      }

      match /fcmTokens/{tokenId} {
        allow read, write: if isSuperAdmin() || (request.auth != null && request.auth.uid == userId);
      }

      match /sessions/{sessionId} {
        allow read, write: if isSuperAdmin() || (request.auth != null && request.auth.uid == userId);
      }
    }
   
    match /invitations/{invitationId} {
      allow read: if true; // Publicly readable by anyone with the unguessable link ID
      allow create: if isSuperAdmin() || (isUserAuthenticated() && isRequestingUserAdmin() && request.resource.data.get('businessId', null) == getCurrentUserBusinessId());
      allow list: if isSuperAdmin() || isUserAuthenticated();
      allow delete: if isSuperAdmin() || 
                       (isUserAuthenticated() && isRequestingUserAdmin() && getCurrentUserBusinessId() == resource.data.get('businessId', 'none')) || 
                       (isUserAuthenticated() && 'email' in request.auth.token && request.auth.token.email.lower() == resource.data.get('email', '').lower());
    }


    match /products/{productId} {
      allow get: if true;
      allow list: if true; // Products are publicly listable for store fronts
      allow create: if isSuperAdmin() || (isUserAuthenticated() && isRequestingUserManager() && 
                      request.resource.data.get('businessId', null) == getCurrentUserBusinessId() && 
                      isSubscriptionActive(request.resource.data.get('businessId', null)));
      allow update: if isSuperAdmin() || (isUserAuthenticated() && isRequestingUserStaff() && 
                      isRequestingUserMemberOf(resource.data.get('businessId', null)) && 
                      isSubscriptionActive(resource.data.get('businessId', null)));
      allow delete: if isSuperAdmin() || (isUserAuthenticated() && isRequestingUserManager() && 
                      isRequestingUserMemberOf(resource.data.get('businessId', null)) && 
                      isSubscriptionActive(resource.data.get('businessId', null)));
    }

    match /receipts/{receiptId} {
        allow get: if isSuperAdmin() || (isUserAuthenticated() && (isRequestingUserMemberOf(resource.data.get('businessId', null)) || resource.data.get('createdBy', null) == request.auth.uid));
        // Support aggregation queries by checking businessId in query filters instead of document content
        allow list: if isSuperAdmin() || (isUserAuthenticated() && (request.query.filters.businessId == getCurrentUserBusinessId() || resource.data.get('createdBy', null) == request.auth.uid));
        
        allow create: if isSuperAdmin() || (isUserAuthenticated() && 
                        isRequestingUserMemberOf(request.resource.data.get('businessId', null)) && 
                        isSubscriptionActive(request.resource.data.get('businessId', null)));
        allow update, delete: if isSuperAdmin() || (isUserAuthenticated() && 
                                isRequestingUserManager() && 
                                isRequestingUserMemberOf(resource.data.get('businessId', null)) && 
                                isSubscriptionActive(resource.data.get('businessId', null)));
    }
    
    match /customers/{customerId} {
      allow get: if isSuperAdmin() || (isUserAuthenticated() && isRequestingUserMemberOf(resource.data.get('businessId', null)));
      // Support aggregation queries by checking businessId in query filters instead of document content
      allow list: if isSuperAdmin() || (isUserAuthenticated() && request.query.filters.businessId == getCurrentUserBusinessId());
      
      allow create: if true; 
      allow update: if isSuperAdmin() || (isUserAuthenticated() && 
                      isRequestingUserStaff() && 
                      isRequestingUserMemberOf(resource.data.get('businessId', null)) && 
                      isSubscriptionActive(resource.data.get('businessId', null)));
      allow delete: if isSuperAdmin() || (isUserAuthenticated() && 
                      isRequestingUserManager() && 
                      isRequestingUserMemberOf(resource.data.get('businessId', null)) && 
                      isSubscriptionActive(resource.data.get('businessId', null)));
    }

    match /admin_analytics/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /system_broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /{path=**}/auditLogs/{logId} {
      allow read, list: if isSuperAdmin();
    }

    match /follow_up_logs/{logId} {
      allow read, list, write: if isSuperAdmin();
    }
  }
}
