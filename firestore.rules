
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =================================================================
    // Helper Functions
    // =================================================================
    
    function isSuperAdmin() {
      // Super admin backdoor
      return request.auth != null && request.auth.token.email == 'belloimam431@gmail.com';
    }

    function isUserAuthenticated() {
      return request.auth != null;
    }

    function isUserAuthenticatedAndExists() {
       return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getRequestingUserData() {
       return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRequestingUserAdmin() {
      return isUserAuthenticatedAndExists() && getRequestingUserData().role == 'admin';
    }

    function isRequestingUserManager() {
      return isUserAuthenticatedAndExists() && (getRequestingUserData().role == 'admin' || getRequestingUserData().role == 'manager');
    }

    function isRequestingUserMemberOf(businessId) {
      if (!isUserAuthenticatedAndExists()) {
        return false;
      }
      let userData = getRequestingUserData();
      // Safely check for the existence of businessId before accessing it.
      return 'businessId' in userData && userData.businessId == businessId;
    }
    
    function isBusinessOwner(businessId) {
      return isUserAuthenticated() && 
        exists(/databases/$(database)/documents/businessInstances/$(businessId)) &&
        get(/databases/$(database)/documents/businessInstances/$(businessId)).data.ownerId == request.auth.uid;
    }

    // =================================================================
    // Public & Admin-Only Collections
    // =================================================================

    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /notifications/{notificationId} {
      allow list, get: if isUserAuthenticated();
      allow create, delete: if isSuperAdmin();
      allow update: if false;
    }
   
    match /purchases/{purchaseId} {
      allow create: if isUserAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, list: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /supportThreads/{threadId} {
      allow read: if isSuperAdmin() || (isUserAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isUserAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isSuperAdmin();
      
      match /messages/{messageId} {
        allow read, create: if isSuperAdmin() || (isUserAuthenticated() && get(/databases/$(database)/documents/supportThreads/$(threadId)).data.userId == request.auth.uid);
      }
    }

    // =================================================================
    // Multi-Tenant Collections
    // =================================================================

    match /businessInstances/{businessId} {
      // Allow get for public storefronts, or private read for members.
      // FIX: Optimized owner check to prevent race conditions during auth token refresh.
      allow get: if resource.data.get(['settings', 'publicStore', 'enabled'], false) == true || isRequestingUserMemberOf(businessId) || (isUserAuthenticated() && resource.data.ownerId == request.auth.uid) || isSuperAdmin();
      
      // Allow list only for Super Admin or for slug checking.
      allow list: if request.query.limit <= 1 || isSuperAdmin();
      
      allow create: if isUserAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isRequestingUserAdmin() && isRequestingUserMemberOf(businessId)) || isBusinessOwner(businessId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
      
      match /subscription_history/{historyId} {
        allow read, list: if isRequestingUserMemberOf(businessId) || isBusinessOwner(businessId) || isSuperAdmin();
        allow create: if isUserAuthenticated() || isSuperAdmin();
        allow update, delete: if false;
      }

      match /auditLogs/{logId} {
        allow list, get: if (isRequestingUserAdmin() && isRequestingUserMemberOf(businessId)) || isBusinessOwner(businessId);
        allow create: if isRequestingUserMemberOf(businessId) || isBusinessOwner(businessId);
        allow update, delete: if false;
      }

      match /onlineOrders/{orderId} {
        // Anyone can create an order.
        allow create: if true;
        // Only members of the business can manage orders.
        allow read, list, update, delete: if isRequestingUserMemberOf(businessId) || isBusinessOwner(businessId) || isSuperAdmin();
      }
    }

    match /users/{userId} {
      allow get: if isSuperAdmin() ||
                    (isUserAuthenticated() && request.auth.uid == userId);
                    

      allow list: if isRequestingUserAdmin() || isSuperAdmin();
      
      allow update: if isSuperAdmin() ||
                       (isUserAuthenticated() && request.auth.uid == userId) || 
                       (isRequestingUserAdmin() && exists(/databases/$(database)/documents/users/$(userId)) && getRequestingUserData().businessId == resource.data.businessId);

      allow create: if isUserAuthenticated() && request.auth.uid == userId;
      
      allow delete: if isSuperAdmin() ||
                       (isRequestingUserAdmin() && request.auth.uid != userId && exists(/databases/$(database)/documents/users/$(userId)) && getRequestingUserData().businessId == resource.data.businessId);
      
      match /notifications/{notificationId} {
        allow get, create, update, delete: if isUserAuthenticated() && request.auth.uid == userId;
      }
      match /notifications {
        allow list: if isUserAuthenticated() && request.auth.uid == userId;
      }
    }
   
    match /invitations/{invitationId} {
      allow create: if isRequestingUserAdmin() && request.resource.data.businessId == getRequestingUserData().businessId;
      allow list: if isRequestingUserAdmin() || isSuperAdmin();
      allow read, delete: if (isUserAuthenticated() && (
          resource.data.email == request.auth.token.email || 
          (isRequestingUserAdmin() && getRequestingUserData().businessId == resource.data.businessId)
      )) || isSuperAdmin();
    }

    match /products/{productId} {
      // Allow public read for storefronts.
      allow get, list: if true;
      allow create: if isRequestingUserManager() && request.resource.data.businessId == getRequestingUserData().businessId;
      allow update, delete: if isRequestingUserManager() && isRequestingUserMemberOf(resource.data.businessId);
    }

    match /receipts/{receiptId} {
      allow get: if isRequestingUserMemberOf(resource.data.businessId) || isSuperAdmin();
      allow list: if isUserAuthenticated() || isSuperAdmin();
      allow create: if isUserAuthenticated() && request.resource.data.businessId == getRequestingUserData().businessId;
      allow update, delete: if isRequestingUserManager() && isRequestingUserMemberOf(resource.data.businessId);
    }
    
    match /customers/{customerId} {
      allow get: if isRequestingUserMemberOf(resource.data.businessId) || isSuperAdmin();
      allow list: if isUserAuthenticated() || isSuperAdmin();
      allow create: if isUserAuthenticated() && request.resource.data.businessId == getRequestingUserData().businessId;
      allow update, delete: if isRequestingUserManager() && isRequestingUserMemberOf(resource.data.businessId);
    }
  }
}
