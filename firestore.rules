rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =================================================================
    // Helper Functions
    // =================================================================
    
    function isSuperAdmin() {
      // Use UIDs for maximum reliability and security
      return request.auth != null && 
             (request.auth.uid == 'jzQgCHzaObeUbeYklTLtQQh03G53' || 
              (request.auth.token != null && 
               'email' in request.auth.token && 
               request.auth.token.email == 'belloimam431@gmail.com'));
    }

    match /{allPaths=**} {
      allow read, write: if isSuperAdmin();
    }

    function isUserAuthenticated() {
      return request.auth != null;
    }

    function isRequestingUserMemberOf(businessId) {
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSuperAdmin() || (request.auth != null && exists(userDocPath) && get(userDocPath).data.businessId == businessId);
    }
    
    function isRequestingUserAdmin() {
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return request.auth != null && exists(userDocPath) && get(userDocPath).data.role == 'admin';
    }

    function isRequestingUserManager() {
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return request.auth != null && exists(userDocPath) && get(userDocPath).data.role in ['admin', 'manager'];
    }

    function isRequestingUserStaff() {
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return request.auth != null && exists(userDocPath) && get(userDocPath).data.role in ['admin', 'manager', 'vendor_operator'];
    }

    function isBusinessOwner(businessId) {
       let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
       return request.auth != null && 
              exists(userDocPath) &&
              get(userDocPath).data.businessId == businessId && 
              get(userDocPath).data.role == 'admin';
    }

    // =================================================================
    // Public & Admin-Only Collections
    // =================================================================

    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /notifications/{notificationId} {
      allow list, get: if isUserAuthenticated();
      allow create, delete: if isSuperAdmin();
      allow update: if false;
    }
   
    match /purchases/{purchaseId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read, list: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /supportThreads/{threadId} {
        allow read: if isSuperAdmin() || (isUserAuthenticated() && get(/databases/$(database)/documents/supportThreads/$(threadId)).data.userId == request.auth.uid);
        allow create: if isUserAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isSuperAdmin();

        match /messages/{messageId} {
            allow create: if isSuperAdmin() || (isUserAuthenticated() && get(/databases/$(database)/documents/supportThreads/$(threadId)).data.userId == request.auth.uid);
            allow read: if isSuperAdmin() || (isUserAuthenticated() && get(/databases/$(database)/documents/supportThreads/$(threadId)).data.userId == request.auth.uid);
        }
    }
    
    match /supportThreads {
        allow list: if isSuperAdmin() || (isUserAuthenticated() && request.query.where.userId == request.auth.uid);
    }
    

    // =================================================================
    // Multi-Tenant Collections
    // =================================================================

    match /businessInstances/{businessId} {
      allow get: if resource.data.get(['settings', 'publicStore', 'enabled'], false) == true || (isUserAuthenticated() && isRequestingUserMemberOf(businessId)) || isSuperAdmin();
      
      allow list: if request.query.limit <= 1 || isSuperAdmin();
      
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update: if (isUserAuthenticated() && isRequestingUserAdmin() && isRequestingUserMemberOf(businessId)) || isBusinessOwner(businessId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
      
      match /subscription_history/{historyId} {
        allow read, list: if (isUserAuthenticated() && isRequestingUserMemberOf(businessId)) || isSuperAdmin();
        allow create: if isUserAuthenticated();
        allow update, delete: if false;
      }

      match /auditLogs/{logId} {
        allow list, get: if (isUserAuthenticated() && isRequestingUserAdmin() && isRequestingUserMemberOf(businessId)) || isSuperAdmin();
        allow create: if (isUserAuthenticated() && isRequestingUserMemberOf(businessId)) || isSuperAdmin();
        allow update, delete: if false;
      }

      match /onlineOrders/{orderId} {
         allow read, list: if (isUserAuthenticated() && isRequestingUserMemberOf(businessId)) || isSuperAdmin();
         // Allow public to create orders, but restrict updates to staff
         allow create: if true; 
         allow update: if (isUserAuthenticated() && isRequestingUserMemberOf(businessId)) || isSuperAdmin();
         allow delete: if false;
      }

      match /stats/{statId} {
        allow read, write: if isSuperAdmin() || (isUserAuthenticated() && isRequestingUserMemberOf(businessId));
      }
    }

    match /users/{userId} {
      allow get: if (request.auth != null && request.auth.uid == userId) || (isRequestingUserAdmin() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == resource.data.businessId) || isSuperAdmin();
      allow list: if isRequestingUserAdmin() || isSuperAdmin();
      
      allow update: if (request.auth != null && request.auth.uid == userId) || 
                       (isRequestingUserAdmin() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == resource.data.businessId) || isSuperAdmin();

      allow create: if request.auth != null && request.auth.uid == userId;
      
      allow delete: if isSuperAdmin() ||
                       (isRequestingUserAdmin() && request.auth != null && request.auth.uid != userId && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == resource.data.businessId);
      
      match /notifications/{notificationId} {
        allow read, write: if (request.auth != null && request.auth.uid == userId) || isSuperAdmin();
      }

      match /fcmTokens/{tokenId} {
        allow read, write: if (request.auth != null && request.auth.uid == userId) || isSuperAdmin();
      }

      match /sessions/{sessionId} {
        allow read, write: if (request.auth != null && request.auth.uid == userId) || isSuperAdmin();
      }
    }
   
    match /invitations/{invitationId} {
      allow read: if true; // Publicly readable by anyone with the unguessable link ID
      allow create: if isSuperAdmin() || (isUserAuthenticated() && isRequestingUserAdmin() && request.resource.data.businessId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId);
      allow list: if isSuperAdmin() || (isUserAuthenticated() && isRequestingUserAdmin());
      allow delete: if (isUserAuthenticated() && isRequestingUserAdmin() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == resource.data.businessId) || 
                       isSuperAdmin() ||
                       (isUserAuthenticated() && 'email' in request.auth.token && request.auth.token.email.lower() == resource.data.email.lower());
    }


    match /products/{productId} {
      allow get, list: if true;
      allow create: if isSuperAdmin() || (isUserAuthenticated() && isRequestingUserManager() && request.resource.data.businessId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId);
      allow update: if isSuperAdmin() || (isUserAuthenticated() && isRequestingUserStaff() && isRequestingUserMemberOf(resource.data.businessId));
      allow delete: if isSuperAdmin() || (isUserAuthenticated() && isRequestingUserManager() && isRequestingUserMemberOf(resource.data.businessId));
    }

    match /receipts/{receiptId} {
        allow read, list: if isSuperAdmin() || (isUserAuthenticated() && (isRequestingUserMemberOf(resource.data.businessId) || resource.data.createdBy == request.auth.uid));
        allow create: if isSuperAdmin() || (isUserAuthenticated() && isRequestingUserMemberOf(request.resource.data.businessId));
        allow update, delete: if isSuperAdmin() || (isUserAuthenticated() && isRequestingUserManager() && isRequestingUserMemberOf(resource.data.businessId));
    }
    
    match /customers/{customerId} {
      allow read, list: if (isUserAuthenticated() && isRequestingUserMemberOf(resource.data.businessId)) || isSuperAdmin();
      // Allow public creation for checkout
      allow create: if true; 
      allow update: if isSuperAdmin() || (isUserAuthenticated() && isRequestingUserStaff() && isRequestingUserMemberOf(resource.data.businessId));
      allow delete: if isSuperAdmin() || (isUserAuthenticated() && isRequestingUserManager() && isRequestingUserMemberOf(resource.data.businessId));
    }

    match /admin_analytics/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /system_broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // --- Global Surveillance Hooks ---
    
    // Enable collectionGroup queries for Cyber Shield
    match /{path=**}/auditLogs/{logId} {
      allow read, list: if isSuperAdmin();
    }

    // Outreach Intelligence
    match /follow_up_logs/{logId} {
      allow read, list, write: if isSuperAdmin();
    }
  }
}
