rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =================================================================
    // Helper Functions
    // =================================================================
    
    function isSuperAdmin() {
      return request.auth != null && 
             request.auth.token != null &&
             'email' in request.auth.token &&
             request.auth.token.email == 'belloimam431@gmail.com';
    }

    function isUserAuthenticated() {
      return request.auth != null;
    }

    function isRequestingUserMemberOf(businessId) {
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return request.auth != null && exists(userDocPath) && get(userDocPath).data.businessId == businessId;
    }
    
    function isRequestingUserAdmin() {
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return request.auth != null && exists(userDocPath) && get(userDocPath).data.role == 'admin';
    }

    function isRequestingUserManager() {
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return request.auth != null && exists(userDocPath) && get(userDocPath).data.role in ['admin', 'manager'];
    }

    function isRequestingUserStaff() {
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return request.auth != null && exists(userDocPath) && get(userDocPath).data.role in ['admin', 'manager', 'vendor_operator'];
    }

    function isBusinessOwner(businessId) {
       let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
       return request.auth != null && 
              exists(userDocPath) &&
              get(userDocPath).data.businessId == businessId && 
              get(userDocPath).data.role == 'admin';
    }

    // =================================================================
    // Public & Admin-Only Collections
    // =================================================================

    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /notifications/{notificationId} {
      allow list, get: if isUserAuthenticated();
      allow create, delete: if isSuperAdmin();
      allow update: if false;
    }
   
    match /purchases/{purchaseId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read, list: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /supportThreads/{threadId} {
        allow read: if isSuperAdmin() || (isUserAuthenticated() && get(/databases/$(database)/documents/supportThreads/$(threadId)).data.userId == request.auth.uid);
        allow create: if isUserAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isSuperAdmin();

        match /messages/{messageId} {
            allow create: if isSuperAdmin() || (isUserAuthenticated() && get(/databases/$(database)/documents/supportThreads/$(threadId)).data.userId == request.auth.uid);
            allow read: if isSuperAdmin() || (isUserAuthenticated() && get(/databases/$(database)/documents/supportThreads/$(threadId)).data.userId == request.auth.uid);
        }
    }
    
    match /supportThreads {
        allow list: if isSuperAdmin() || (isUserAuthenticated() && request.query.where.userId == request.auth.uid);
    }
    

    // =================================================================
    // Multi-Tenant Collections
    // =================================================================

    match /businessInstances/{businessId} {
      allow get: if resource.data.get(['settings', 'publicStore', 'enabled'], false) == true || (isUserAuthenticated() && isRequestingUserMemberOf(businessId));
      
      allow list: if request.query.limit <= 1 || isSuperAdmin();
      
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update: if (isUserAuthenticated() && isRequestingUserAdmin() && isRequestingUserMemberOf(businessId)) || isBusinessOwner(businessId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
      
      match /subscription_history/{historyId} {
        allow read, list: if isUserAuthenticated() && isRequestingUserMemberOf(businessId);
        allow create: if isUserAuthenticated();
        allow update, delete: if false;
      }

      match /auditLogs/{logId} {
        allow list, get: if isUserAuthenticated() && isRequestingUserAdmin() && isRequestingUserMemberOf(businessId);
        allow create: if isUserAuthenticated() && isRequestingUserMemberOf(businessId);
        allow update, delete: if false;
      }

      match /onlineOrders/{orderId} {
         allow read, list: if isUserAuthenticated() && isRequestingUserMemberOf(businessId);
         allow write: if isUserAuthenticated() && isRequestingUserMemberOf(businessId);
      }
    }

    match /users/{userId} {
      allow get: if (request.auth != null && request.auth.uid == userId) || (isRequestingUserAdmin() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == resource.data.businessId) || isSuperAdmin();
      allow list: if isRequestingUserAdmin();
      
      allow update: if (request.auth != null && request.auth.uid == userId) || 
                       (isRequestingUserAdmin() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == resource.data.businessId) || isSuperAdmin();

      allow create: if request.auth != null && request.auth.uid == userId;
      
      allow delete: if isSuperAdmin() ||
                       (isRequestingUserAdmin() && request.auth != null && request.auth.uid != userId && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == resource.data.businessId);
      
      match /notifications/{notificationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
   
    match /invitations/{invitationId} {
      allow read: if true; // Publicly readable by anyone with the unguessable link ID
      allow create: if isUserAuthenticated() && isRequestingUserAdmin() && request.resource.data.businessId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId;
      allow list: if isSuperAdmin() || (isUserAuthenticated() && isRequestingUserAdmin());
      allow delete: if (isUserAuthenticated() && isRequestingUserAdmin() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == resource.data.businessId) || isSuperAdmin();
    }


    match /products/{productId} {
      allow get, list: if true;
      allow create: if isUserAuthenticated() && isRequestingUserManager() && request.resource.data.businessId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId;
      allow update: if isUserAuthenticated() && isRequestingUserStaff() && isRequestingUserMemberOf(resource.data.businessId);
      allow delete: if isUserAuthenticated() && isRequestingUserManager() && isRequestingUserMemberOf(resource.data.businessId);
    }

    match /receipts/{receiptId} {
        allow read, list: if isUserAuthenticated() && (isRequestingUserMemberOf(resource.data.businessId) || resource.data.createdBy == request.auth.uid);
        allow create: if isUserAuthenticated() && isRequestingUserMemberOf(request.resource.data.businessId);
        allow update, delete: if isUserAuthenticated() && isRequestingUserManager() && isRequestingUserMemberOf(resource.data.businessId);
    }
    
    match /customers/{customerId} {
      allow read, list: if isUserAuthenticated() && isRequestingUserMemberOf(resource.data.businessId);
      allow create: if isUserAuthenticated() && isRequestingUserStaff() && isRequestingUserMemberOf(request.resource.data.businessId);
      allow update: if isUserAuthenticated() && isRequestingUserStaff() && isRequestingUserMemberOf(resource.data.businessId);
      allow delete: if isUserAuthenticated() && isRequestingUserManager() && isRequestingUserMemberOf(resource.data.businessId);
    }
  }
}
