{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zeneva",
  "version": "0.4.5",
  "identifier": "com.zeneva.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:9007",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zeneva",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.paystack.co; connect-src 'self' https://api.imgbb.com https://js.paystack.co https://api.paystack.co https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://firebasestorage.googleapis.com https://*.googleapis.com https://*.firebaseio.com; img-src 'self' data: https://i.ibb.co https://firebasestorage.googleapis.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": true,
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "dialog": {},
    "single-instance": {},
    "updater": {
      "endpoints": [
        "https://github.com/I-m-a-m-4/zeneva/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDREQTAyQjM4QTk1MkI4QgpSV1NMSzVXS3N3TGFCTWdnUVdWM2FhVnZoaG9DaHlWaTZnK1V1WHBIcm9leTl2ZkduUGNnUndicwo="
    }
  }
}
