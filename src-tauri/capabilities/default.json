{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-all",
    "core:process:allow-exit",
    "fs:default",
    "sql:default",
    "stronghold:default",
    "updater:default",
    "shell:default",
    "log:default"
  ]
}
